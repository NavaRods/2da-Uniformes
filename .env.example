# El acceso ya no se controla con una variable de entorno: se administra
# desde la pantalla de Usuarios dentro de la app (colección "usuarios" en
# Firestore). Ver README para el bootstrap del primer Admin.

# "npm run dev" usa por defecto el emulador local (no producción). Pon esto
# en false en .env.local solo si necesitas probar puntualmente contra el
# proyecto real de Firebase.
# VITE_USE_EMULATORS=false
