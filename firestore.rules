rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Autorización ---
    // Único punto de verdad de quién puede entrar: un doc en `usuarios` con
    // ID = correo (en minúsculas). Se administra desde la pantalla de
    // Usuarios dentro de la app, excepto el rol "superadmin" (ver abajo).
    //
    // Roles: "superadmin" (todo el poder, incluida la gestión de Admins),
    // "admin" (Configuración y Usuarios, todas las Unidades), "estado_mayor"
    // (consulta todas las Unidades, no escribe en ninguna), "responsable" e
    // "instructor" (una sola Unidad fija, control total sobre ella).
    //
    // IMPORTANTE (bootstrap): "superadmin" nunca se crea ni edita desde la
    // app (ni un Admin puede tocarlo): se da de alta a mano, una sola vez,
    // desde la consola de Firebase → Firestore → colección "usuarios" →
    // documento con ID = tu correo en minúsculas, campos
    // { rol: "superadmin", unidad: null, nombre: "..." }. De ahí en
    // adelante, ese Super Admin (o un Admin que dé de alta) crea a los demás
    // desde la app.
    function usuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower()));
    }

    function esUsuarioAutorizado() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower())) &&
        // Sin el campo "activo" (documentos viejos) se trata como activo.
        usuarioActual().data.get("activo", true) == true;
    }

    function miRol() {
      return usuarioActual().data.rol;
    }

    // Admin y Super Admin: mismo nivel para administrar la app (Usuarios,
    // Configuración, todas las Unidades con permiso de escritura). Se
    // diferencian en que a un Super Admin nadie lo edita desde la app (ver
    // match /usuarios/{email}).
    function esAdmin() {
      return esUsuarioAutorizado() && miRol() in ["admin", "superadmin"];
    }

    function esEstadoMayor() {
      return esUsuarioAutorizado() && miRol() == "estado_mayor";
    }

    // Ve todas las Unidades sin tener una fija: Admin/Super Admin para
    // administrar, Estado Mayor para consultar (de solo lectura).
    function veTodasLasUnidades() {
      return esAdmin() || esEstadoMayor();
    }

    function miUnidad() {
      return usuarioActual().data.unidad;
    }

    // Puede LEER esa Unidad: Admin/Super Admin/Estado Mayor en cualquiera,
    // Responsable/Instructor solo la suya.
    function puedeVerUnidad(unidad) {
      return veTodasLasUnidades() || (esUsuarioAutorizado() && unidad == miUnidad());
    }

    // Puede ESCRIBIR en esa Unidad: Admin/Super Admin en cualquiera,
    // Responsable/Instructor solo la suya. Estado Mayor en ninguna (es de
    // solo lectura, aunque vea todas).
    function puedeEscribirUnidad(unidad) {
      return esAdmin() || (esUsuarioAutorizado() && unidad == miUnidad());
    }

    function unidadDelElemento(elementoId) {
      return get(/databases/$(database)/documents/elementos/$(elementoId)).data.unidad;
    }

    // --- Versiones de colecciones (ver src/lib/versiones.js) ---
    // Catálogo, grados, Unidades y usuarios se leen de la caché de cada
    // dispositivo mientras no cambie su versión en meta/versiones. Por eso
    // toda escritura en ellas debe actualizar su versión en el mismo lote:
    // si no, los demás dispositivos nunca se enterarían del cambio.
    function versionActualizada(coleccion) {
      return getAfter(/databases/$(database)/documents/meta/versiones).data.get(coleccion, null) == request.time;
    }

    function versionesCambiadas() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- Respaldos (ver src/lib/respaldo.js) ---
    // Verificador de la contraseña de respaldos (nunca la contraseña).
    match /meta/respaldo {
      allow read: if esAdmin();
      allow create, update: if esAdmin() &&
        request.resource.data.keys().hasOnly(["sal", "verificador", "iteraciones", "por", "actualizadoEn"]) &&
        request.resource.data.sal is string &&
        request.resource.data.verificador is string &&
        request.resource.data.iteraciones is int && request.resource.data.iteraciones >= 100000 &&
        request.resource.data.por == request.auth.token.email.lower() &&
        request.resource.data.actualizadoEn == request.time;
    }

    // Última restauración: quién, cuándo y de qué archivo. Cada lote de una
    // restauración la escribe; es lo que habilita restaurandoRespaldo().
    match /meta/restauracion {
      allow read: if esAdmin();
      allow create, update: if esAdmin() &&
        request.resource.data.keys().hasOnly(["en", "por", "respaldo"]) &&
        request.resource.data.en == request.time &&
        request.resource.data.por == request.auth.token.email.lower() &&
        request.resource.data.respaldo is string;
    }

    // Un Admin restaurando un respaldo: el mismo lote marca meta/restauracion.
    // Permite reescribir pedidos, abonos y mensualidades tal como estaban en
    // el respaldo (sus reglas normales impiden, con razón, fijar un saldo o
    // crear un abono suelto).
    function restaurandoRespaldo() {
      let marca = getAfter(/databases/$(database)/documents/meta/restauracion);
      return esAdmin() && marca != null && marca.data.get("en", null) == request.time;
    }

    match /meta/versiones {
      allow read: if esUsuarioAutorizado();
      // Solo se escribe la hora del servidor de la colección que cambió.
      allow create, update: if esAdmin() &&
        request.resource.data.keys().hasOnly(["catalogo", "grados", "unidades", "usuarios"]) &&
        (!("catalogo" in versionesCambiadas()) || request.resource.data.catalogo == request.time) &&
        (!("grados" in versionesCambiadas()) || request.resource.data.grados == request.time) &&
        (!("unidades" in versionesCambiadas()) || request.resource.data.unidades == request.time) &&
        (!("usuarios" in versionesCambiadas()) || request.resource.data.usuarios == request.time);
    }

    // --- Usuarios (cuentas con acceso) ---
    // "grado" es solo una etiqueta libre (no afecta permisos). "activo"
    // permite suspender el acceso de alguien sin borrar su cuenta.
    // "superadmin" no está entre los roles válidos aquí a propósito: no se
    // puede crear ni editar un usuario con ese rol desde la app.
    function usuarioValido(datos) {
      return datos.keys().hasOnly(["nombre", "rol", "unidad", "grado", "activo", "creadoEn"]) &&
        datos.rol in ["admin", "estado_mayor", "responsable", "instructor"] &&
        (datos.rol in ["admin", "estado_mayor"] || (datos.unidad is string && datos.unidad.size() > 0)) &&
        (!("nombre" in datos) || datos.nombre is string) &&
        (!("grado" in datos) || datos.grado is string) &&
        (!("activo" in datos) || datos.activo is bool);
    }

    match /usuarios/{email} {
      allow read: if esAdmin() || (request.auth != null && request.auth.token.email.lower() == email);
      allow create: if esAdmin() && usuarioValido(request.resource.data) && versionActualizada("usuarios");
      // Un Admin no puede quitarse a sí mismo el acceso ni el rol (así la
      // app nunca se queda sin Admin), y nadie —ni otro Admin— puede tocar
      // la cuenta de un Super Admin desde la app.
      allow update: if esAdmin() && usuarioValido(request.resource.data) &&
        versionActualizada("usuarios") &&
        resource.data.rol != "superadmin" &&
        (request.auth.token.email.lower() != email ||
          (request.resource.data.rol == "admin" &&
           request.resource.data.get("activo", true) == true));
      allow delete: if esAdmin() && request.auth.token.email.lower() != email &&
        resource.data.rol != "superadmin" &&
        versionActualizada("usuarios");
    }

    // --- Unidades (lista abierta, la administra un Admin) ---
    function unidadListaValida(datos) {
      return datos.keys().hasOnly(["nombre", "creadoEn"]) &&
        datos.nombre is string && datos.nombre.size() > 0;
    }

    match /unidades/{unidadId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esAdmin() && unidadListaValida(request.resource.data) &&
        versionActualizada("unidades");
      allow delete: if esAdmin() && versionActualizada("unidades");
    }

    // --- Grados militares ---
    // Los administra un Admin desde Configuración; todos los usuarios los leen
    // (formularios, Estado de Fuerza). "categoria" es el renglón del Estado de
    // Fuerza en que se cuenta el grado; "rango" mayor = jerarquía más alta.
    function gradoValido(datos) {
      return datos.keys().hasOnly(["nombre", "categoria", "rango", "creadoEn"]) &&
        datos.nombre is string && datos.nombre.size() > 0 &&
        datos.categoria in ["Jefes", "Oficiales", "Clases", "Cadetes", "Tropas", "Reclutas"] &&
        datos.rango is number;
    }

    match /grados/{gradoId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esAdmin() && gradoValido(request.resource.data) &&
        versionActualizada("grados");
      allow delete: if esAdmin() && versionActualizada("grados");
    }

    // --- Elementos ---
    function elementoValido(datos) {
      return datos.keys().hasOnly([
        "unidad", "grupo", "nombre", "edad", "telefonos", "direccion",
        "fechaNacimiento", "escuela", "turno", "gradoEscolar", "tutor",
        "comoSeEntero", "seguroSocial", "alergias", "pagaMensualidad",
        // documentacionEntregada ya no se usa; se permite solo para no rechazar
        // elementos antiguos que todavía lo tengan guardado.
        "pagaInscripcion", "documentacionEntregada", "fechaBaja", "creadoEn",
        "numeroOrden", "gradoMilitar", "antecedentes", "antecedentesDetalle",
        "practicaDeporte", "deporte", "actualizadoEn"
      ]) &&
      // Hora del servidor de esta escritura: la sincronización por cambios
      // (src/lib/elementos.js) pide solo los elementos con actualizadoEn
      // reciente, así que ninguna escritura puede omitirla.
      datos.actualizadoEn == request.time &&
      datos.nombre is string && datos.nombre.size() > 0 &&
      datos.unidad is string && datos.unidad.size() > 0 &&
      (!("grupo" in datos) || datos.grupo is string) &&
      (!("telefonos" in datos) || datos.telefonos is list) &&
      (!("pagaMensualidad" in datos) || datos.pagaMensualidad is bool) &&
      (!("pagaInscripcion" in datos) || datos.pagaInscripcion is bool) &&
      (!("documentacionEntregada" in datos) || datos.documentacionEntregada is bool) &&
      (!("fechaBaja" in datos) || datos.fechaBaja is string) &&
      // Número de orden opcional: V/F + unidad (2) + año (2) + lista (3). Ej. V0218001.
      (!("numeroOrden" in datos) || (datos.numeroOrden is string && datos.numeroOrden.matches('^([VF][0-9]{7})?$'))) &&
      (!("gradoMilitar" in datos) || datos.gradoMilitar is string) &&
      (!("antecedentes" in datos) || datos.antecedentes in ["", "Sí", "No"]) &&
      (!("antecedentesDetalle" in datos) || datos.antecedentesDetalle is string) &&
      (!("practicaDeporte" in datos) || datos.practicaDeporte in ["", "Sí", "No"]) &&
      (!("deporte" in datos) || datos.deporte is string);
    }

    match /elementos/{elementoId} {
      allow read: if puedeVerUnidad(resource.data.unidad);
      allow create: if elementoValido(request.resource.data) && puedeEscribirUnidad(request.resource.data.unidad);
      allow update: if elementoValido(request.resource.data) &&
        puedeEscribirUnidad(resource.data.unidad) && puedeEscribirUnidad(request.resource.data.unidad);
      // Las bajas normales se marcan con fechaBaja; borrar un elemento (y con
      // eso su historial) es cosa de un Admin.
      allow delete: if esAdmin();

      // --- Pedidos de un elemento ---
      // "unidad" copia la Unidad del elemento en cada pedido, abono y cuota:
      // las consultas que juntan datos de varios elementos (Relación de pagos)
      // no pueden consultar al elemento dueño, así que filtran por este campo.
      function pedidoValido(datos, unidadElemento) {
        return datos.keys().hasOnly([
          "articulo", "productoNombre", "talla", "color", "cantidad",
          "precioTotal", "saldoPendiente", "entregado", "quienEntrego",
          "fechaEntrega", "cambioPendiente", "motivoCambio",
          "fechaCambioSolicitado", "ultimoAbonoId", "creadoEn", "unidad",
          "actualizadoEn", "descontoInventario", "cambioTalla", "cambioColor"
        ]) &&
        // Hora del servidor de esta escritura: los pedidos de una Unidad se
        // sincronizan por cambios (src/lib/sincronia.js), igual que los
        // elementos, así que ninguna escritura puede omitirla.
        datos.actualizadoEn == request.time &&
        (!("unidad" in datos) || datos.unidad == unidadElemento) &&
        datos.articulo is string &&
        datos.precioTotal is number &&
        datos.saldoPendiente is number &&
        (!("cambioPendiente" in datos) || datos.cambioPendiente is bool) &&
        (!("entregado" in datos) || datos.entregado is bool);
      }

      // El saldo de un pedido solo baja junto con un abono nuevo: en la misma
      // escritura (batch) se crea el abono cuyo ID queda en "ultimoAbonoId" y
      // su monto es exactamente lo que bajó el saldo. Así nadie puede poner
      // el saldo en 0 "a mano" ni crear un abono sin descontarlo.
      function saldoBajaPorAbono(elementoId, pedidoId, antes, despues) {
        return despues.get("ultimoAbonoId", "") is string &&
          despues.get("ultimoAbonoId", "") != "" &&
          despues.get("ultimoAbonoId", "") != antes.get("ultimoAbonoId", "") &&
          !exists(/databases/$(database)/documents/elementos/$(elementoId)/pedidos/$(pedidoId)/abonos/$(despues.ultimoAbonoId)) &&
          existsAfter(/databases/$(database)/documents/elementos/$(elementoId)/pedidos/$(pedidoId)/abonos/$(despues.ultimoAbonoId)) &&
          getAfter(/databases/$(database)/documents/elementos/$(elementoId)/pedidos/$(pedidoId)/abonos/$(despues.ultimoAbonoId)).data.monto ==
            antes.saldoPendiente - despues.saldoPendiente;
      }

      // Campos de un pedido que sí pueden cambiar después de creado. El precio,
      // el artículo, la fecha de creación, etc. quedan fijos.
      function pedidoSoloCambiaPermitido(antes, despues) {
        let cambios = despues.diff(antes).affectedKeys();
        return cambios.hasOnly([
          "entregado", "quienEntrego", "fechaEntrega",
          "cambioPendiente", "motivoCambio", "fechaCambioSolicitado",
          "saldoPendiente", "ultimoAbonoId", "unidad", "actualizadoEn",
          "descontoInventario", "cambioTalla", "cambioColor"
        ]) ||
        // Al resolver un cambio la pieza se ajusta a lo que se pidió (talla y
        // color nuevos, con su texto "articulo"): solo en ese paso, cuando el
        // cambio estaba pendiente y ya no lo queda, y solo a la talla y el
        // color que traía el cambio. El precio y el producto no cambian.
        (antes.get("cambioPendiente", false) == true &&
          despues.get("cambioPendiente", false) == false &&
          cambios.hasOnly([
            "entregado", "quienEntrego", "fechaEntrega",
            "cambioPendiente", "motivoCambio", "fechaCambioSolicitado",
            "unidad", "actualizadoEn", "descontoInventario",
            "cambioTalla", "cambioColor", "talla", "color", "articulo"
          ]) &&
          despues.talla == antes.get("cambioTalla", antes.talla) &&
          despues.color == antes.get("cambioColor", antes.color));
      }

      // --- Cuotas (mensualidades pagadas) de un elemento ---
      function cuotaValida(datos, unidadElemento) {
        return datos.keys().hasOnly([
          "tipo", "meses", "montoPorMes", "total", "quienRecibio",
          "fecha", "fechaLocal", "horaLocal", "unidad", "elementoNombre"
        ]) &&
        datos.unidad == unidadElemento &&
        datos.tipo == "mensualidad" &&
        datos.meses is list && datos.meses.size() > 0 &&
        datos.montoPorMes is number && datos.montoPorMes > 0 &&
        datos.total is number && datos.total == datos.montoPorMes * datos.meses.size() &&
        datos.fechaLocal is string;
      }

      match /cuotas/{cuotaId} {
        allow read: if puedeVerUnidad(unidadDelElemento(elementoId));
        allow create: if restaurandoRespaldo() ||
          (cuotaValida(request.resource.data, unidadDelElemento(elementoId)) &&
            puedeEscribirUnidad(unidadDelElemento(elementoId)));
        // Un pago mal registrado no se edita. Solo un Admin puede borrarlo
        // (rastro de auditoría) y luego se vuelve a capturar. Única excepción
        // de edición: un Admin puede agregar el campo "unidad" a cuotas
        // anteriores (migración de datos).
        allow update: if restaurandoRespaldo() ||
          (esAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unidad"]) &&
            request.resource.data.unidad == unidadDelElemento(elementoId));
        allow delete: if esAdmin();
      }

      match /pedidos/{pedidoId} {
        allow read: if puedeVerUnidad(unidadDelElemento(elementoId));

        // Un pedido nace sin pagos: el saldo es el precio completo.
        allow create: if restaurandoRespaldo() ||
          (pedidoValido(request.resource.data, unidadDelElemento(elementoId)) &&
            "unidad" in request.resource.data &&
            puedeEscribirUnidad(unidadDelElemento(elementoId)) &&
            request.resource.data.precioTotal >= 0 &&
            request.resource.data.saldoPendiente == request.resource.data.precioTotal &&
            !("ultimoAbonoId" in request.resource.data));

        allow update: if restaurandoRespaldo() ||
          (pedidoValido(request.resource.data, unidadDelElemento(elementoId)) &&
            puedeEscribirUnidad(unidadDelElemento(elementoId)) &&
            pedidoSoloCambiaPermitido(resource.data, request.resource.data) &&
            (request.resource.data.saldoPendiente == resource.data.saldoPendiente ||
              saldoBajaPorAbono(elementoId, pedidoId, resource.data, request.resource.data)));

        // Un pedido sin pagos (saldo = precio) lo puede borrar cualquiera de
        // la Unidad, p. ej. uno capturado por error. Si ya tiene pagos, solo
        // un Admin. Siempre junto con su baja (bajasPedidos), para que los
        // demás dispositivos se enteren del borrado.
        allow delete: if puedeEscribirUnidad(unidadDelElemento(elementoId)) &&
          (esAdmin() || resource.data.saldoPendiente == resource.data.precioTotal) &&
          existsAfter(/databases/$(database)/documents/bajasPedidos/$(elementoId + "_" + pedidoId));

        // --- Abonos de un pedido ---
        function abonoValido(datos, unidadElemento) {
          return datos.keys().hasOnly([
            "monto", "quienRecibio", "fecha", "fechaLocal", "horaLocal", "unidad",
            // Copias del elemento y pedido para la Relación de pagos.
            "elementoNombre", "articulo", "productoNombre", "talla", "color", "saldoTras"
          ]) &&
          datos.unidad == unidadElemento &&
          datos.monto is number && datos.monto > 0 &&
          datos.fechaLocal is string;
        }

        match /abonos/{abonoId} {
          allow read: if puedeVerUnidad(unidadDelElemento(elementoId));

          // Un abono solo se crea junto con el descuento exacto en el saldo
          // del pedido (ver saldoBajaPorAbono).
          allow create: if restaurandoRespaldo() ||
            (abonoValido(request.resource.data, unidadDelElemento(elementoId)) &&
              puedeEscribirUnidad(unidadDelElemento(elementoId)) &&
              getAfter(/databases/$(database)/documents/elementos/$(elementoId)/pedidos/$(pedidoId)).data.get("ultimoAbonoId", "") == abonoId &&
              getAfter(/databases/$(database)/documents/elementos/$(elementoId)/pedidos/$(pedidoId)).data.saldoPendiente ==
                get(/databases/$(database)/documents/elementos/$(elementoId)/pedidos/$(pedidoId)).data.saldoPendiente - request.resource.data.monto);

          // Los abonos no se editan y solo un Admin los borra (al eliminar un
          // pedido que ya tenía pagos). Única excepción de edición: un Admin
          // puede agregar el campo "unidad" a abonos anteriores (migración).
          allow update: if restaurandoRespaldo() ||
            (esAdmin() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unidad"]) &&
              request.resource.data.unidad == unidadDelElemento(elementoId));
          allow delete: if esAdmin();
        }
      }
    }

    // --- Catálogo de productos ---
    // Compartido entre todas las Unidades (mismo club, mismos productos).
    // Cualquier usuario autorizado lo consulta; solo un Admin lo edita.
    // "grupo" ya no lo usa la app (el catálogo dejó de separarse por
    // Varonil/Femenino), pero se deja como campo permitido opcional para no
    // romper productos antiguos que todavía lo tengan guardado.
    function productoValido(datos) {
      return datos.keys().hasOnly(["nombre", "grupo", "precio", "tallaTipo", "tallas", "colores"]) &&
      datos.nombre is string && datos.nombre.size() > 0 &&
      datos.precio is number &&
      datos.tallaTipo is string &&
      datos.tallas is list;
    }

    match /catalogo/{productoId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esAdmin() && productoValido(request.resource.data) &&
        versionActualizada("catalogo");
      allow delete: if esAdmin() && versionActualizada("catalogo");
    }

    // --- Asistencia diaria ---
    // Un doc por día y Unidad: asistencias/{fecha}/porUnidad/{unidad}, con
    // { unidad, fecha, estados: { elementoId: estado, ... } }. Separado así
    // (en vez de un doc plano por día con cualquier elementoId como clave)
    // para poder proteger la escritura por Unidad a nivel de regla.
    function asistenciaValida(datos, unidad) {
      return datos.keys().hasOnly(["unidad", "fecha", "estados"]) &&
        datos.unidad == unidad &&
        datos.fecha is string &&
        datos.estados is map;
    }

    match /asistencias/{fecha}/porUnidad/{unidad} {
      allow read: if puedeVerUnidad(unidad);
      allow write: if puedeEscribirUnidad(unidad) && asistenciaValida(request.resource.data, unidad);
    }

    // Formato anterior (un doc plano por día con todos los elementos). Ya no
    // se escribe; un Admin solo puede leerlo y borrarlo para migrarlo.
    match /asistencias/{fecha} {
      allow read, delete: if esAdmin();
    }

    // --- Configuración de la app ---
    // Ajustes compartidos (hoy, solo el número de WhatsApp que recibe la
    // Relación de pagos y el Estado de Fuerza). Un número con código de
    // país: 11 a 15 dígitos. Lo puede cambiar cualquier usuario con acceso.
    match /configuracion/{ajusteId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esUsuarioAutorizado() &&
        request.resource.data.keys().hasOnly(["whatsappNumero"]) &&
        request.resource.data.whatsappNumero is string &&
        request.resource.data.whatsappNumero.matches('^[0-9]{11,15}$');
    }

    // --- Consultas de grupo de colección ---
    // La Relación de pagos y el reporte de asistencia leen documentos de
    // muchos elementos a la vez. Firestore exige una regla con comodín
    // recursivo para esas consultas, y la regla solo puede apoyarse en campos
    // del propio documento (no en otro documento ni en la ruta, que la
    // consulta no fija). Por eso pedidos, abonos y cuotas guardan "unidad", y
    // quien no ve todas las Unidades siempre consulta con
    // `where("unidad", "==", su unidad)`.
    match /{path=**}/abonos/{abonoId} {
      allow read: if puedeVerUnidad(resource.data.unidad);
    }

    match /{path=**}/cuotas/{cuotaId} {
      allow read: if puedeVerUnidad(resource.data.unidad);
    }

    match /{path=**}/pedidos/{pedidoId} {
      allow read: if puedeVerUnidad(resource.data.unidad);
    }

    // --- Bajas de pedidos (ver eliminarPedido en src/lib/pedidos.js) ---
    // Constancia de un pedido borrado, para que los demás dispositivos (que
    // sincronizan por cambios y no ven los borrados) lo quiten. Solo se crea
    // en el mismo lote en que se borra ese pedido, por quien puede borrarlo.
    match /bajasPedidos/{bajaId} {
      allow read: if puedeVerUnidad(resource.data.unidad);
      allow create: if request.resource.data.keys().hasOnly(["unidad", "elementoId", "pedidoId", "en"]) &&
        bajaId == request.resource.data.elementoId + "_" + request.resource.data.pedidoId &&
        request.resource.data.en == request.time &&
        request.resource.data.unidad == unidadDelElemento(request.resource.data.elementoId) &&
        puedeEscribirUnidad(request.resource.data.unidad) &&
        exists(/databases/$(database)/documents/elementos/$(request.resource.data.elementoId)/pedidos/$(request.resource.data.pedidoId)) &&
        !existsAfter(/databases/$(database)/documents/elementos/$(request.resource.data.elementoId)/pedidos/$(request.resource.data.pedidoId));
    }

    // --- Uniforme recibido (ver src/lib/inventario.js) ---
    // Piezas que ya llegaron y esperan a entregarse, por Unidad, producto,
    // talla y color. La cantidad nunca queda negativa: entregar sin
    // existencias no descuenta (la app pregunta antes).
    function inventarioValido(datos) {
      return datos.keys().hasOnly([
        "unidad", "productoNombre", "talla", "color", "cantidad", "actualizadoEn"
      ]) &&
      datos.unidad is string &&
      datos.productoNombre is string && datos.productoNombre.size() > 0 &&
      datos.talla is string &&
      datos.color is string &&
      datos.cantidad is int && datos.cantidad >= 0;
    }

    match /inventario/{id} {
      allow read: if puedeVerUnidad(resource.data.unidad);
      allow create: if restaurandoRespaldo() ||
        (inventarioValido(request.resource.data) &&
          puedeEscribirUnidad(request.resource.data.unidad));
      allow update: if restaurandoRespaldo() ||
        (inventarioValido(request.resource.data) &&
          request.resource.data.unidad == resource.data.unidad &&
          request.resource.data.productoNombre == resource.data.productoNombre &&
          request.resource.data.talla == resource.data.talla &&
          request.resource.data.color == resource.data.color &&
          puedeEscribirUnidad(resource.data.unidad));
      allow delete: if puedeEscribirUnidad(resource.data.unidad);
    }

    // --- Relaciones de pagos validadas (ver src/lib/relaciones.js) ---
    // Un doc por Unidad y día: el resumen de lo cobrado, la validación de la
    // entrega del dinero y las piezas que va entregando el proveedor.
    function relacionValida(datos) {
      return datos.keys().hasOnly([
        "unidad", "fecha", "total", "totalUniformes", "totalMensualidades",
        "mesesCobrados", "piezas", "mensualidades", "entregadoPor",
        "entregadoEn", "actualizadoEn"
      ]) &&
      datos.unidad is string && datos.unidad.size() > 0 &&
      datos.fecha is string &&
      datos.total is number &&
      datos.piezas is list &&
      datos.mensualidades is list &&
      datos.actualizadoEn == request.time;
    }

    match /relaciones/{relacionId} {
      allow read: if puedeVerUnidad(resource.data.unidad);
      allow create: if relacionValida(request.resource.data) &&
        puedeEscribirUnidad(request.resource.data.unidad);
      allow update: if relacionValida(request.resource.data) &&
        request.resource.data.unidad == resource.data.unidad &&
        request.resource.data.fecha == resource.data.fecha &&
        puedeEscribirUnidad(resource.data.unidad);
      allow delete: if esAdmin();
    }

    match /{path=**}/porUnidad/{unidadId} {
      allow read: if puedeVerUnidad(resource.data.unidad);
    }

    // Cualquier otra ruta no contemplada arriba queda bloqueada por
    // defecto (Firestore deniega lo que no coincide con una regla).
  }
}
