rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Autorización ---
    // Único punto de verdad de quién puede entrar: un doc en `usuarios` con
    // ID = correo (en minúsculas). Ya no es una lista fija en este archivo;
    // se administra desde la pantalla de Usuarios dentro de la app.
    // IMPORTANTE (bootstrap): el primer usuario Admin no se puede crear desde
    // la app (necesita ya ser Admin para eso). Se crea a mano una sola vez
    // desde la consola de Firebase: colección "usuarios", doc con ID = tu
    // correo en minúsculas, campos { rol: "admin", unidad: null, nombre: "..." }.
    function usuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower()));
    }

    function esUsuarioAutorizado() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower())) &&
        // Sin el campo "activo" (documentos viejos) se trata como activo.
        usuarioActual().data.get("activo", true) == true;
    }

    function esAdmin() {
      return esUsuarioAutorizado() && usuarioActual().data.rol == "admin";
    }

    function miUnidad() {
      return usuarioActual().data.unidad;
    }

    function enMiUnidad(unidad) {
      return esAdmin() || (esUsuarioAutorizado() && unidad == miUnidad());
    }

    function unidadDelElemento(elementoId) {
      return get(/databases/$(database)/documents/elementos/$(elementoId)).data.unidad;
    }

    // --- Usuarios (cuentas con acceso) ---
    // "grado" es solo una etiqueta libre (no afecta permisos). "activo"
    // permite suspender el acceso de alguien sin borrar su cuenta.
    function usuarioValido(datos) {
      return datos.keys().hasOnly(["nombre", "rol", "unidad", "grado", "activo", "creadoEn"]) &&
        datos.rol in ["admin", "operador"] &&
        (datos.rol == "admin" || (datos.unidad is string && datos.unidad.size() > 0)) &&
        (!("nombre" in datos) || datos.nombre is string) &&
        (!("grado" in datos) || datos.grado is string) &&
        (!("activo" in datos) || datos.activo is bool);
    }

    match /usuarios/{email} {
      allow read: if esAdmin() || (request.auth != null && request.auth.token.email.lower() == email);
      allow create: if esAdmin() && usuarioValido(request.resource.data);
      // Un Admin no puede quitarse a sí mismo el acceso ni el rol (ni
      // borrarse): así la app nunca se queda sin Admin. Otro Admin sí puede.
      allow update: if esAdmin() && usuarioValido(request.resource.data) &&
        (request.auth.token.email.lower() != email ||
          (request.resource.data.rol == "admin" &&
           request.resource.data.get("activo", true) == true));
      allow delete: if esAdmin() && request.auth.token.email.lower() != email;
    }

    // --- Unidades (lista abierta, la administra un Admin) ---
    function unidadListaValida(datos) {
      return datos.keys().hasOnly(["nombre", "creadoEn"]) &&
        datos.nombre is string && datos.nombre.size() > 0;
    }

    match /unidades/{unidadId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esAdmin() && unidadListaValida(request.resource.data);
      allow delete: if esAdmin();
    }

    // --- Elementos ---
    function elementoValido(datos) {
      return datos.keys().hasOnly([
        "unidad", "grupo", "nombre", "edad", "telefonos", "direccion",
        "fechaNacimiento", "escuela", "turno", "gradoEscolar", "tutor",
        "comoSeEntero", "seguroSocial", "alergias", "pagaMensualidad",
        // documentacionEntregada ya no se usa; se permite solo para no rechazar
        // elementos antiguos que todavía lo tengan guardado.
        "pagaInscripcion", "documentacionEntregada", "fechaBaja", "creadoEn"
      ]) &&
      datos.nombre is string && datos.nombre.size() > 0 &&
      datos.unidad is string && datos.unidad.size() > 0 &&
      (!("grupo" in datos) || datos.grupo is string) &&
      (!("telefonos" in datos) || datos.telefonos is list) &&
      (!("pagaMensualidad" in datos) || datos.pagaMensualidad is bool) &&
      (!("pagaInscripcion" in datos) || datos.pagaInscripcion is bool) &&
      (!("documentacionEntregada" in datos) || datos.documentacionEntregada is bool) &&
      (!("fechaBaja" in datos) || datos.fechaBaja is string);
    }

    match /elementos/{elementoId} {
      allow read: if enMiUnidad(resource.data.unidad);
      allow create: if elementoValido(request.resource.data) && enMiUnidad(request.resource.data.unidad);
      allow update: if elementoValido(request.resource.data) &&
        enMiUnidad(resource.data.unidad) && enMiUnidad(request.resource.data.unidad);
      allow delete: if enMiUnidad(resource.data.unidad);

      // --- Pedidos de un elemento ---
      // "unidad" copia la Unidad del elemento en cada pedido, abono y cuota:
      // las consultas que juntan datos de varios elementos (Relación de pagos)
      // no pueden consultar al elemento dueño, así que filtran por este campo.
      function pedidoValido(datos, unidadElemento) {
        return datos.keys().hasOnly([
          "articulo", "productoNombre", "talla", "color", "cantidad",
          "precioTotal", "saldoPendiente", "entregado", "quienEntrego",
          "fechaEntrega", "cambioPendiente", "motivoCambio",
          "fechaCambioSolicitado", "creadoEn", "unidad"
        ]) &&
        (!("unidad" in datos) || datos.unidad == unidadElemento) &&
        datos.articulo is string &&
        datos.precioTotal is number &&
        datos.saldoPendiente is number &&
        (!("cambioPendiente" in datos) || datos.cambioPendiente is bool) &&
        (!("entregado" in datos) || datos.entregado is bool);
      }

      // --- Cuotas (mensualidades pagadas) de un elemento ---
      function cuotaValida(datos, unidadElemento) {
        return datos.keys().hasOnly([
          "tipo", "meses", "montoPorMes", "total", "quienRecibio",
          "fecha", "fechaLocal", "horaLocal", "unidad"
        ]) &&
        datos.unidad == unidadElemento &&
        datos.tipo == "mensualidad" &&
        datos.meses is list && datos.meses.size() > 0 &&
        datos.montoPorMes is number && datos.montoPorMes > 0 &&
        datos.total is number &&
        datos.fechaLocal is string;
      }

      match /cuotas/{cuotaId} {
        allow read: if enMiUnidad(unidadDelElemento(elementoId));
        allow create: if cuotaValida(request.resource.data, unidadDelElemento(elementoId)) &&
          enMiUnidad(unidadDelElemento(elementoId));
        // Un pago mal registrado se elimina y se vuelve a capturar; no se edita.
        // Única excepción: un Admin puede agregar el campo "unidad" a cuotas
        // anteriores (migración de datos).
        allow update: if esAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unidad"]) &&
          request.resource.data.unidad == unidadDelElemento(elementoId);
        allow delete: if enMiUnidad(unidadDelElemento(elementoId));
      }

      match /pedidos/{pedidoId} {
        allow read: if enMiUnidad(unidadDelElemento(elementoId));
        allow create: if pedidoValido(request.resource.data, unidadDelElemento(elementoId)) &&
          "unidad" in request.resource.data &&
          enMiUnidad(unidadDelElemento(elementoId));
        allow update: if pedidoValido(request.resource.data, unidadDelElemento(elementoId)) &&
          enMiUnidad(unidadDelElemento(elementoId));
        allow delete: if enMiUnidad(unidadDelElemento(elementoId));

        // --- Abonos de un pedido ---
        function abonoValido(datos, unidadElemento) {
          return datos.keys().hasOnly(["monto", "quienRecibio", "fecha", "fechaLocal", "horaLocal", "unidad"]) &&
          datos.unidad == unidadElemento &&
          datos.monto is number &&
          datos.fechaLocal is string;
        }

        match /abonos/{abonoId} {
          allow read: if enMiUnidad(unidadDelElemento(elementoId));
          allow create: if abonoValido(request.resource.data, unidadDelElemento(elementoId)) &&
            enMiUnidad(unidadDelElemento(elementoId));
          // Los abonos no se editan. Solo se borran al eliminar el pedido
          // completo (la app los borra junto con el pedido). Única excepción:
          // un Admin puede agregar el campo "unidad" a abonos anteriores
          // (migración de datos).
          allow update: if esAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unidad"]) &&
            request.resource.data.unidad == unidadDelElemento(elementoId);
          allow delete: if enMiUnidad(unidadDelElemento(elementoId));
        }
      }
    }

    // --- Catálogo de productos ---
    // Compartido entre todas las Unidades (mismo club, mismos productos).
    // Cualquier usuario autorizado lo consulta; solo un Admin lo edita.
    // "grupo" ya no lo usa la app (el catálogo dejó de separarse por
    // Varonil/Femenino), pero se deja como campo permitido opcional para no
    // romper productos antiguos que todavía lo tengan guardado.
    function productoValido(datos) {
      return datos.keys().hasOnly(["nombre", "grupo", "precio", "tallaTipo", "tallas", "colores"]) &&
      datos.nombre is string && datos.nombre.size() > 0 &&
      datos.precio is number &&
      datos.tallaTipo is string &&
      datos.tallas is list;
    }

    match /catalogo/{productoId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esAdmin() && productoValido(request.resource.data);
      allow delete: if esAdmin();
    }

    // --- Asistencia diaria ---
    // Un doc por día y Unidad: asistencias/{fecha}/porUnidad/{unidad}, con
    // { unidad, fecha, estados: { elementoId: estado, ... } }. Separado así
    // (en vez de un doc plano por día con cualquier elementoId como clave)
    // para poder proteger la escritura por Unidad a nivel de regla.
    function asistenciaValida(datos, unidad) {
      return datos.keys().hasOnly(["unidad", "fecha", "estados"]) &&
        datos.unidad == unidad &&
        datos.fecha is string &&
        datos.estados is map;
    }

    match /asistencias/{fecha}/porUnidad/{unidad} {
      allow read: if enMiUnidad(unidad);
      allow write: if enMiUnidad(unidad) && asistenciaValida(request.resource.data, unidad);
    }

    // Formato anterior (un doc plano por día con todos los elementos). Ya no
    // se escribe; un Admin solo puede leerlo y borrarlo para migrarlo.
    match /asistencias/{fecha} {
      allow read, delete: if esAdmin();
    }

    // --- Configuración de la app ---
    // Ajustes compartidos (hoy, solo el número de WhatsApp que recibe la
    // Relación de pagos). Un número con código de país: 11 a 15 dígitos.
    // Lo puede cambiar cualquier usuario con acceso (Admin u Operador).
    match /configuracion/{ajusteId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esUsuarioAutorizado() &&
        request.resource.data.keys().hasOnly(["whatsappNumero"]) &&
        request.resource.data.whatsappNumero is string &&
        request.resource.data.whatsappNumero.matches('^[0-9]{11,15}$');
    }

    // --- Consultas de grupo de colección ---
    // La Relación de pagos y el reporte de asistencia leen documentos de
    // muchos elementos a la vez. Firestore exige una regla con comodín
    // recursivo para esas consultas, y la regla solo puede apoyarse en campos
    // del propio documento (no en otro documento ni en la ruta, que la
    // consulta no fija). Por eso pedidos, abonos y cuotas guardan "unidad", y
    // el Operador siempre consulta con `where("unidad", "==", su unidad)`.
    match /{path=**}/abonos/{abonoId} {
      allow read: if enMiUnidad(resource.data.unidad);
    }

    match /{path=**}/cuotas/{cuotaId} {
      allow read: if enMiUnidad(resource.data.unidad);
    }

    match /{path=**}/pedidos/{pedidoId} {
      allow read: if enMiUnidad(resource.data.unidad);
    }

    match /{path=**}/porUnidad/{unidadId} {
      allow read: if enMiUnidad(resource.data.unidad);
    }

    // Cualquier otra ruta no contemplada arriba queda bloqueada por
    // defecto (Firestore deniega lo que no coincide con una regla).
  }
}
