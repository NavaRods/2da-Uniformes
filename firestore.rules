rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Autorización ---
    // Único punto de verdad de quién puede entrar. Editar esta lista es la
    // única forma de dar/quitar acceso (agregar o quitar un correo aquí).
    function correosAutorizados() {
      return [
        "carlos.navarguez03@gmail.com"
        // Agrega aquí el correo de tu compañera, ej:
        // , "correo.companera@gmail.com"
      ];
    }

    function esUsuarioAutorizado() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in correosAutorizados();
    }

    // --- Elementos ---
    function elementoValido(datos) {
      return datos.keys().hasOnly([
        "unidad", "grupo", "nombre", "edad", "telefonos", "direccion",
        "fechaNacimiento", "escuela", "turno", "gradoEscolar", "tutor",
        "comoSeEntero", "seguroSocial", "alergias", "pagaMensualidad",
        // documentacionEntregada ya no se usa; se permite solo para no rechazar
        // elementos antiguos que todavía lo tengan guardado.
        "pagaInscripcion", "documentacionEntregada", "fechaBaja", "creadoEn"
      ]) &&
      datos.nombre is string && datos.nombre.size() > 0 &&
      (!("grupo" in datos) || datos.grupo is string) &&
      (!("telefonos" in datos) || datos.telefonos is list) &&
      (!("pagaMensualidad" in datos) || datos.pagaMensualidad is bool) &&
      (!("pagaInscripcion" in datos) || datos.pagaInscripcion is bool) &&
      (!("documentacionEntregada" in datos) || datos.documentacionEntregada is bool) &&
      (!("fechaBaja" in datos) || datos.fechaBaja is string);
    }

    match /elementos/{elementoId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esUsuarioAutorizado() && elementoValido(request.resource.data);
      allow delete: if esUsuarioAutorizado();

      // --- Pedidos de un elemento ---
      function pedidoValido(datos) {
        return datos.keys().hasOnly([
          "articulo", "productoNombre", "talla", "color", "cantidad",
          "precioTotal", "saldoPendiente", "entregado", "quienEntrego",
          "fechaEntrega", "cambioPendiente", "motivoCambio",
          "fechaCambioSolicitado", "creadoEn"
        ]) &&
        datos.articulo is string &&
        datos.precioTotal is number &&
        datos.saldoPendiente is number &&
        (!("cambioPendiente" in datos) || datos.cambioPendiente is bool) &&
        (!("entregado" in datos) || datos.entregado is bool);
      }

      // --- Cuotas (mensualidades pagadas) de un elemento ---
      function cuotaValida(datos) {
        return datos.keys().hasOnly([
          "tipo", "meses", "montoPorMes", "total", "quienRecibio",
          "fecha", "fechaLocal", "horaLocal"
        ]) &&
        datos.tipo == "mensualidad" &&
        datos.meses is list && datos.meses.size() > 0 &&
        datos.montoPorMes is number && datos.montoPorMes > 0 &&
        datos.total is number &&
        datos.fechaLocal is string;
      }

      match /cuotas/{cuotaId} {
        allow read: if esUsuarioAutorizado();
        allow create: if esUsuarioAutorizado() && cuotaValida(request.resource.data);
        // Un pago mal registrado se elimina y se vuelve a capturar; no se edita.
        allow update: if false;
        allow delete: if esUsuarioAutorizado();
      }

      match /pedidos/{pedidoId} {
        allow read: if esUsuarioAutorizado();
        allow create, update: if esUsuarioAutorizado() && pedidoValido(request.resource.data);
        allow delete: if esUsuarioAutorizado();

        // --- Abonos de un pedido ---
        function abonoValido(datos) {
          return datos.keys().hasOnly(["monto", "quienRecibio", "fecha", "fechaLocal", "horaLocal"]) &&
          datos.monto is number &&
          datos.fechaLocal is string;
        }

        match /abonos/{abonoId} {
          allow read: if esUsuarioAutorizado();
          allow create: if esUsuarioAutorizado() && abonoValido(request.resource.data);
          // Los abonos no se editan. Solo se borran al eliminar el pedido
          // completo (la app los borra junto con el pedido).
          allow update: if false;
          allow delete: if esUsuarioAutorizado();
        }
      }
    }

    // --- Catálogo de productos ---
    // "grupo" ya no lo usa la app (el catálogo dejó de separarse por
    // Varonil/Femenino), pero se deja como campo permitido opcional para no
    // romper productos antiguos que todavía lo tengan guardado.
    function productoValido(datos) {
      return datos.keys().hasOnly(["nombre", "grupo", "precio", "tallaTipo", "tallas", "colores"]) &&
      datos.nombre is string && datos.nombre.size() > 0 &&
      datos.precio is number &&
      datos.tallaTipo is string &&
      datos.tallas is list;
    }

    match /catalogo/{productoId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esUsuarioAutorizado() && productoValido(request.resource.data);
      allow delete: if esUsuarioAutorizado();
    }

    // --- Asistencia diaria ---
    // Documento por día: { elementoId: true/false, ... }. Las claves son
    // dinámicas (un ID por elemento) así que solo se valida que quien
    // escribe esté autorizado.
    match /asistencias/{fecha} {
      allow read, write: if esUsuarioAutorizado();
    }

    // Cualquier otra ruta no contemplada arriba queda bloqueada por
    // defecto (Firestore deniega lo que no coincide con una regla).
  }
}
