{
  "name": "vmm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm test && npm run build && firebase deploy --only hosting,firestore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-uniformes-rules \"vitest run --config vitest.rules.config.js\"",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "seed:pruebas": "node scripts/datos-prueba-emulador.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^14.4.0",
    "oxlint": "^1.75.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
