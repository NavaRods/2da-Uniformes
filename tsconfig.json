{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    // Vite compila; tsc solo revisa tipos (npm run typecheck).
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Migración gradual: los .js siguen funcionando tal cual (sin revisarse)
    // y cada archivo que pase a .ts/.tsx se revisa en modo estricto.
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
